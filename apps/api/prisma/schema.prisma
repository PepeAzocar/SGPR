// ---- Dominio 6: formación académica e instituciones -------------------------

model EducationInstitutionType {
  id       String  @id @default(cuid())
  code     String  @unique @db.VarChar(40)
  name     String  @db.VarChar(150)
  isActive Boolean @default(true)

  institutions EducationInstitution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Mantenedor "Instituciones académicas".
model EducationInstitution {
  id                 String                   @id @default(cuid())
  code               String                   @unique @db.VarChar(40)
  name               String                   @db.VarChar(200)
  institutionType    EducationInstitutionType @relation(fields: [institutionTypeId], references: [id])
  institutionTypeId  String
  rut                String?                  @db.VarChar(12)
  country            Country                  @relation(fields: [countryId], references: [id])
  countryId          String
  recognizedByState  Boolean                  @default(true)
  recognizedByMinsal Boolean                  @default(false)
  accreditationCode  String?                  @db.VarChar(60)

  effectiveFrom DateTime
  effectiveTo   DateTime?
  active        Boolean   @default(true)

  academicBackgrounds EmployeeAcademicBackground[]
  postgraduates       ApsPostgraduate[]
  trainingActivities  ApsTrainingActivity[]

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EducationType {
  id                 String  @id @default(cuid())
  code               String  @unique @db.VarChar(40) // TECHNICAL_TITLE, PROFESSIONAL_TITLE, BACHELOR, LICENCIATURA, SPECIALTY, DIPLOMA, POSTGRADUATE_DIPLOMA, MASTER, DOCTORATE, POSTDOCTORATE, COURSE, INTERNSHIP, SEMINAR, WORKSHOP, CONGRESS, OTHER
  name               String  @db.VarChar(150)
  countsForApsCareer Boolean @default(false) // formación académica != capacitación válida para puntaje
  isActive           Boolean @default(true)

  academicBackgrounds EmployeeAcademicBackground[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeAcademicBackground {
  id              String               @id @default(cuid())
  employee        Employee             @relation(fields: [employeeId], references: [id])
  employeeId      String
  educationType   EducationType        @relation(fields: [educationTypeId], references: [id])
  educationTypeId String
  institution     EducationInstitution @relation(fields: [institutionId], references: [id])
  institutionId   String

  programName String  @db.VarChar(200)
  titleName   String? @db.VarChar(200)
  specialty   String? @db.VarChar(150)

  startDate       DateTime?
  endDate         DateTime?
  graduationDate  DateTime?
  certificateDate DateTime?
  totalHours      Int?
  semesters       Int?

  country   Country? @relation(fields: [countryId], references: [id])
  countryId String?

  recognizedInChile    Boolean @default(true)
  recognitionAuthority String? @db.VarChar(150)
  documentId           String?

  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        ApsAcademicStatus @default(IN_PROGRESS)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApsPostgraduate {
  id               String               @id @default(cuid())
  employee         Employee             @relation(fields: [employeeId], references: [id])
  employeeId       String
  postgraduateType String               @db.VarChar(30) // SPECIALIZATION / POSTGRADUATE_DIPLOMA / MASTER / DOCTORATE
  institution      EducationInstitution @relation(fields: [institutionId], references: [id])
  institutionId    String
  name             String               @db.VarChar(200)
  specialty        ApsProfession?       @relation(fields: [specialtyId], references: [id])
  specialtyId      String?

  startDate       DateTime?
  endDate         DateTime?
  totalHours      Int?
  certificateDate DateTime?
  approved        Boolean   @default(false)
  apsRelated      Boolean   @default(false)
  recognized      Boolean   @default(false)
  recognitionDate DateTime?
  documentId      String?

  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        ApsAcademicStatus @default(IN_PROGRESS)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Dominio 7: mérito ------------------------------------------------------

model ApsPerformanceEvaluation {
  id                   String   @id @default(cuid())
  employee             Employee @relation(fields: [employeeId], references: [id])
  employeeId           String
  evaluationPeriodCode String   @db.VarChar(20)

  evaluationStart DateTime
  evaluationEnd   DateTime
