  updatedAt DateTime @updatedAt
}

model ApsEmployeeTrainingYear {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  year       Int

  earnedPoints            Decimal  @default(0) @db.Decimal(10, 4)
  recognizedPoints        Decimal  @default(0) @db.Decimal(10, 4)
  computablePoints        Decimal  @default(0) @db.Decimal(10, 4)
  annualLimit             Decimal? @db.Decimal(10, 4)
  careerAccumulatedPoints Decimal  @default(0) @db.Decimal(10, 4)

  closed      Boolean   @default(false)
  closingDate DateTime?

  trainings EmployeeApsTraining[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year])
}

model ApsMunicipalTrainingProgram {
  id                     String           @id @default(cuid())
  administrativeEntity   LegalEntity      @relation(fields: [administrativeEntityId], references: [id])
  administrativeEntityId String
  year                   Int
  programCode            String           @unique @db.VarChar(40)
  name                   String           @db.VarChar(200)
  approvalDate           DateTime?
  resolutionNumber       String?          @db.VarChar(60)
  startDate              DateTime
  endDate                DateTime
  status                 ApsProgramStatus @default(DRAFT)

  items ApsMunicipalTrainingProgramItem[]

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
