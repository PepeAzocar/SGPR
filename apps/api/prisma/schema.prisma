}

model ApsMeritAssignment {
  id                      String                   @id @default(cuid())
  employee                Employee                 @relation(fields: [employeeId], references: [id])
  employeeId              String
  performanceEvaluation   ApsPerformanceEvaluation @relation(fields: [performanceEvaluationId], references: [id])
