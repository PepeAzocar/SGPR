  updatedAt DateTime @updatedAt
}

model ApsMunicipalTrainingProgramItem {
  id                 String                      @id @default(cuid())
  program            ApsMunicipalTrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId          String
  trainingActivity   ApsTrainingActivity         @relation(fields: [trainingActivityId], references: [id])
  trainingActivityId String
  category           ApsEmployeeCategory?        @relation(fields: [categoryId], references: [id])
  categoryId         String?
  targetGroup        String?                     @db.VarChar(150)
