// Requiere aprobación del Concejo Municipal y vence a más tardar el 31 de
// diciembre del año presupuestario (validado en el servicio, no en el esquema).
model ApsSpecialTemporaryAssignment {
  id                     String               @id @default(cuid())
  administrativeEntity   LegalEntity          @relation(fields: [administrativeEntityId], references: [id])
  administrativeEntityId String
  code                   String               @unique @db.VarChar(40)
  name                   String               @db.VarChar(200)
  description            String?              @db.VarChar(500)
  category               ApsEmployeeCategory? @relation(fields: [categoryId], references: [id])
  categoryId             String?
  careerLevel            Int?

  percentage      Decimal? @db.Decimal(6, 4)
  fixedAmount     Decimal? @db.Decimal(12, 2)
  calculationBase String?  @db.VarChar(30)

  budgetYear    Int
  effectiveFrom DateTime
  effectiveTo   DateTime // máximo 31-12 del budgetYear

  municipalCouncilApproval Boolean @default(false)
  resolutionNumber         String? @db.VarChar(60)
  active                   Boolean @default(true)

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Puente a Nómina ---------------------------------------------------------
//
// Snapshot remuneracional 1:1 con Contract, sólo aplicable cuando
// Contract.laborRegimeId = LEY_19378. Los conceptos de nómina (sueldo base,
// asignación APS, zona, responsabilidad, desempeño difícil, mérito,
// asignaciones especiales, postgrado) NO se modelan aquí como tabla propia:
// se crean como filas de PayrollConcept (ya existente) y sus reglas como
// PayrollFormula (ya existente) filtradas por laborRegimeId, leyendo esta
// tabla — así Nómina nunca interpreta la Ley 19.378 directamente.
model ApsContractProfile {
  id         String   @id @default(cuid())
  contract   Contract @relation(fields: [contractId], references: [id])
  contractId String   @unique

  category    ApsEmployeeCategory @relation(fields: [categoryId], references: [id])
  categoryId  String
  careerLevel Int
  facility    ApsHealthFacility   @relation(fields: [facilityId], references: [id])
  facilityId  String
  weeklyHours Int

  baseSalaryAmount               Decimal  @db.Decimal(12, 2)
  primaryCareAssignmentAmount    Decimal? @db.Decimal(12, 2)
  zonePercentage                 Decimal? @db.Decimal(6, 4)
  zoneAmount                     Decimal? @db.Decimal(12, 2)
  difficultPerformancePercentage Decimal? @db.Decimal(6, 4)
  difficultPerformanceAmount     Decimal? @db.Decimal(12, 2)
  responsibilityPercentage       Decimal? @db.Decimal(6, 4)
  responsibilityAmount           Decimal? @db.Decimal(12, 2)
  meritPercentage                Decimal? @db.Decimal(6, 4)
  meritAmount                    Decimal? @db.Decimal(12, 2)
  specialAssignmentAmount        Decimal? @db.Decimal(12, 2)
  postgraduateAssignmentAmount   Decimal? @db.Decimal(12, 2)
  totalApsAssignments            Decimal  @default(0) @db.Decimal(12, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?
  version       Int       @default(1)
  status        String    @default("DRAFT") @db.VarChar(30) // DRAFT / ACTIVE / SUPERSEDED

  createdBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
