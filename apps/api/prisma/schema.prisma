// Prisma schema — Sistema de Remuneraciones y Gestión de Personas (Chile)
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth / usuarios del sistema
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  RRHH
  EMPLOYEE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(EMPLOYEE)
  isActive     Boolean   @default(true)
  employee     Employee? @relation(fields: [employeeId], references: [id])
  employeeId   String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Estructura organizacional
//
// Jerarquía: LegalEntity -> BusinessUnit -> Division -> Department -> Position.
// CostCenter es un maestro independiente (dimensión de imputación financiera):
// puede colgar directamente de una LegalEntity y ser referenciado desde
// Department y/o Position, sin ser un nivel rígido de la jerarquía.
// Cargo es la clasificación reutilizable del puesto (título/rol genérico);
// Position es el asiento concreto dentro de un Department que ocupa un Cargo.
//
// Los campos code/effectiveFrom/effectiveTo/status en Department y Position
// son opcionales a nivel de base de datos por compatibilidad con registros
// creados antes de esta estructura; los DTO de creación los exigen para
// registros nuevos.
// ---------------------------------------------------------------------------

enum OrgUnitStatus {
  ACTIVE
  INACTIVE
}

model LegalEntity {
  id            String        @id @default(cuid())
  code          String        @unique @db.VarChar(50)
  name          String        @db.VarChar(150)
  description   String?       @db.VarChar(500)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        OrgUnitStatus @default(ACTIVE)

  // Identidad legal del empleador, usada por el motor de documentos
  // contractuales para membretes y cláusulas (razón social, domicilio,
  // representante legal). Opcionales por compatibilidad con entidades
  // creadas antes de este módulo.
  rut                     String? @db.VarChar(12)
  legalName               String? @db.VarChar(200) // razón social
  address                 String? @db.VarChar(300)
  city                    String? @db.VarChar(100)
  legalRepresentativeName String? @db.VarChar(200)
  legalRepresentativeRut  String? @db.VarChar(12)

  businessUnits                  BusinessUnit[]
  costCenters                    CostCenter[]
  contracts                      Contract[]
  payrollFormulas                PayrollFormula[]
  createdBy                      String?                         @db.VarChar(150)
  updatedBy                      String?                         @db.VarChar(150)
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  apsAdministrativeEntityProfile ApsAdministrativeEntityProfile?
  apsHealthFacilities            ApsHealthFacility[]
  apsCareerLevels                ApsCareerLevel[]
  apsBaseSalaryScales            ApsBaseSalaryScale[]
  apsCareers                     ApsCareer[]
  apsExperienceRules             ApsExperienceRule[]
  apsMunicipalTrainingPrograms   ApsMunicipalTrainingProgram[]
  apsStaffingPositions           ApsStaffingPosition[]
  apsSpecialTemporaryAssignments ApsSpecialTemporaryAssignment[]
}

model BusinessUnit {
  id            String        @id @default(cuid())
  code          String        @unique @db.VarChar(50)
  name          String        @db.VarChar(150)
  description   String?       @db.VarChar(500)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        OrgUnitStatus @default(ACTIVE)

  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id])
  legalEntityId String

  divisions Division[]

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Division {
  id            String        @id @default(cuid())
  code          String        @unique @db.VarChar(50)
  name          String        @db.VarChar(150)
  description   String?       @db.VarChar(500)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        OrgUnitStatus @default(ACTIVE)

  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  businessUnitId String

  parent           Division?  @relation("DivisionToParent", fields: [parentDivisionId], references: [id])
  parentDivisionId String?
  children         Division[] @relation("DivisionToParent")

  departments Department[]

  createdBy           String?             @db.VarChar(150)
  updatedBy           String?             @db.VarChar(150)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  apsHealthFacilities ApsHealthFacility[]
}

model CostCenter {
  id            String        @id @default(cuid())
  code          String        @unique @db.VarChar(50)
  name          String        @db.VarChar(150)
  description   String?       @db.VarChar(500)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        OrgUnitStatus @default(ACTIVE)

  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id])
  legalEntityId String?

  parent   CostCenter?  @relation("CostCenterToParent", fields: [parentId], references: [id])
  parentId String?
  children CostCenter[] @relation("CostCenterToParent")

  manager           Employee? @relation("CostCenterManager", fields: [managerEmployeeId], references: [id])
  managerEmployeeId String?

  departments Department[]
  positions   Position[]

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Clasificación de puesto reutilizable (ej. "Analista de Remuneraciones",
// "Jefe de Departamento"), independiente del asiento concreto (Position).
model Cargo {
  id            String        @id @default(cuid())
  code          String        @unique @db.VarChar(50)
  name          String        @db.VarChar(150)
  description   String?       @db.VarChar(500)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        OrgUnitStatus @default(ACTIVE)

  positions Position[]

  createdBy                    String?                       @db.VarChar(150)
  updatedBy                    String?                       @db.VarChar(150)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  apsStaffingPositions         ApsStaffingPosition[]
  apsEmployeeAssignments       ApsEmployeeAssignment[]
  apsResponsibilityAssignments ApsResponsibilityAssignment[]
}

model Department {
  id            String        @id @default(cuid())
  code          String?       @unique @db.VarChar(50)
  name          String
  description   String?       @db.VarChar(500)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  status        OrgUnitStatus @default(ACTIVE)

  division   Division? @relation(fields: [divisionId], references: [id])
  divisionId String?

  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])
  costCenterId String?

  parent    Department?  @relation("DepartmentToParent", fields: [parentId], references: [id])
  parentId  String?
  children  Department[] @relation("DepartmentToParent")
  positions Position[]

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Position {
  id            String        @id @default(cuid())
  code          String?       @unique @db.VarChar(50)
  title         String
  description   String?       @db.VarChar(500)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  status        OrgUnitStatus @default(ACTIVE)

  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String

  cargo   Cargo?  @relation(fields: [cargoId], references: [id])
  cargoId String?

  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])
  costCenterId String?

  contracts Contract[]

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Catálogos geográficos
//
// País -> Región -> Comuna forman una jerarquía de dependencia: una Región
// siempre pertenece a un País y una Comuna siempre pertenece a una Región.
// Nacionalidad es un catálogo independiente (gentilicios), sin jerarquía.
//
// Employee sigue guardando nationality/birthCountry/birthRegion/birthCommune
// como texto (compatibilidad con datos existentes): el frontend puebla esos
// campos seleccionando desde estos catálogos en vez de escritura libre.
// ---------------------------------------------------------------------------

model Country {
  id       String  @id @default(cuid())
  code     String  @unique @db.VarChar(10)
  name     String  @unique @db.VarChar(100)
  isActive Boolean @default(true)

  regions Region[]

  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  educationInstitutions       EducationInstitution[]
  employeeAcademicBackgrounds EmployeeAcademicBackground[]
}

model Region {
  id       String  @id @default(cuid())
  code     String? @db.VarChar(20)
  name     String  @db.VarChar(100)
  isActive Boolean @default(true)

  country   Country @relation(fields: [countryId], references: [id])
  countryId String

  communes Commune[]

  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  apsAdministrativeEntityProfiles ApsAdministrativeEntityProfile[]
  apsHealthServices               ApsHealthService[]

  @@unique([countryId, name])
}

model Commune {
  id       String  @id @default(cuid())
  code     String? @db.VarChar(20)
  name     String  @db.VarChar(100)
  isActive Boolean @default(true)

  region   Region @relation(fields: [regionId], references: [id])
  regionId String

  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  apsAdministrativeEntityProfiles ApsAdministrativeEntityProfile[]
  apsHealthFacilities             ApsHealthFacility[]
  apsZoneAssignments              ApsZoneAssignment[]

  @@unique([regionId, name])
}

model Nationality {
  id       String  @id @default(cuid())
  code     String? @db.VarChar(10)
  name     String  @unique @db.VarChar(100)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Personas / trabajadores
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  CIVIL_UNION
}

model Employee {
  id String @id @default(cuid())

  // Identificación
  documentType   String  @db.VarChar(20) // tipo_documento: RUT, PASAPORTE, DNI, etc.
  documentNumber String  @db.VarChar(30) // numero_documento: valor del documento tal como fue ingresado
  rut            String? @unique @db.VarChar(12) // condicional: solo cuando documentType = RUT, formato 12.345.678-9

  firstName      String
  lastName       String
  secondLastName String?
  socialName     String?        @db.VarChar(150) // nombre_social
  birthDate      DateTime?
  gender         Gender         @default(UNSPECIFIED)
  maritalStatus  MaritalStatus?
  nationality    String?        @default("Chilena")
  birthCountry   String?        @db.VarChar(80) // pais_nacimiento
  birthRegion    String?        @db.VarChar(80) // region_nacimiento
  birthCommune   String?        @db.VarChar(80) // comuna_nacimiento
  photoUrl       String?        @db.Text // fotografia_url: data URL (imagen comprimida en base64, ver EmployeePhotoCapture en el frontend)

  email             String? @unique
  phone             String?
  address           String?
  commune           String?
  region            String?
  bankName          String?
  bankAccountType   String?
  bankAccountNumber String?

  status EmployeeStatus @default(ACTIVE)

  // AFP, salud y ahorro previsional ya no son atributos fijos del empleado:
  // son datos con vigencia histórica, ver EmployeeAfp / HealthAffiliation / EmployeePensionSaving.
  afpAffiliations    EmployeeAfp[]
  healthAffiliations HealthAffiliation[]
  pensionSavings     EmployeePensionSaving[]

  contracts          Contract[]
  events             EmployeeEvent[]
  bankAccounts       EmployeeBankAccount[]
  leaves             Leave[]
  user               User?
  managedCostCenters CostCenter[]          @relation("CostCenterManager")
  generatedDocuments GeneratedDocument[]
  payrollResults     PayrollResult[]

  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  apsCareer                        ApsCareer?
  apsCareerHistories               ApsCareerHistory[]
  apsRecognizedServices            ApsRecognizedService[]
  apsServiceExclusions             ApsServiceExclusion[]
  apsBienniums                     ApsBiennium[]
  employeeApsTrainings             EmployeeApsTraining[]
  apsEmployeeTrainingYears         ApsEmployeeTrainingYear[]
  employeeAcademicBackgrounds      EmployeeAcademicBackground[]
  apsPostgraduates                 ApsPostgraduate[]
  apsPerformanceEvaluations        ApsPerformanceEvaluation[]
  apsMeritAssignments              ApsMeritAssignment[]
  apsEmployeeAssignments           ApsEmployeeAssignment[]
  apsWorkSchedules                 ApsWorkSchedule[]
  apsResponsibilityAssignments     ApsResponsibilityAssignment[]
  apsEmployeeDifficultPerformances ApsEmployeeDifficultPerformance[]
  employeeApsZoneAssignments       EmployeeApsZoneAssignment[]
}

// ---------------------------------------------------------------------------
// Contratos
//
// Todo contrato queda tipificado por su régimen jurídico (LaborRegime) y su
// tipo contractual (ContractType), que a su vez depende del régimen: el mismo
// catálogo ContractType sirve para modelar, en el futuro, tipos propios de
// regímenes estatutarios (docente, asistente de la educación, salud APS, etc.)
// sin tocar el modelo de Contract. Por ahora sólo se usa el régimen Código del
// Trabajo (sector privado); el resto del catálogo LaborRegime queda
// parametrizado para cuando se necesite activar esos regímenes.
// ---------------------------------------------------------------------------

// Régimen jurídico de la relación laboral (Código del Trabajo, Estatuto
// Docente, Estatuto APS, etc.). Catálogo parametrizable y versionable por
// vigencia normativa: no se asume que la realidad actual (o futura) quede
// cubierta únicamente por un único estatuto.
model LaborRegime {
  id            String    @id @default(cuid())
  code          String    @unique @db.VarChar(30) // ej. CODIGO_TRABAJO, LEY_19070, LEY_19378
  name          String    @db.VarChar(150)
  mainNorm      String?   @db.VarChar(200) // norma_principal, ej. "DFL N°1 - Código del Trabajo"
  isActive      Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  contractTypes    ContractType[]
  contracts        Contract[]
  employeeEvents   EmployeeEvent[]
  payrollFormulas  PayrollFormula[]
  contractMatrices ContractMatrix[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  legalParameters LegalParameter[]
}

// Tipo contractual dentro de un régimen jurídico (ej. INDEFINIDO/PLAZO_FIJO
// bajo Código del Trabajo). Reemplaza el enum fijo anterior para poder
// agregar tipos nuevos (incluidos los de regímenes estatutarios futuros) sin
// una migración de esquema.
model ContractType {
  id   String @id @default(cuid())
  code String @db.VarChar(30) // ej. INDEFINIDO, PLAZO_FIJO
  name String @db.VarChar(100)

  laborRegime   LaborRegime @relation(fields: [laborRegimeId], references: [id])
  laborRegimeId String

  requiresEndDate            Boolean @default(false)
  allowsExtension            Boolean @default(false)
  allowsIndefiniteConversion Boolean @default(false)
  payrollRelevant            Boolean @default(true) // ej. honorarios no pasa por el motor de liquidaciones

  isActive      Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  contracts        Contract[]
  contractMatrices ContractMatrix[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([laborRegimeId, code])
}

model Contract {
  id             String @id @default(cuid())
  contractNumber String @db.VarChar(30) // número interno, único por entidad empleadora
  sequenceNumber Int    @default(1) // secuencia efectiva del contrato para esta relación laboral

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  position   Position @relation(fields: [positionId], references: [id])
  positionId String

  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id]) // empleador
  legalEntityId String

  laborRegime    LaborRegime  @relation(fields: [laborRegimeId], references: [id])
  laborRegimeId  String
  contractType   ContractType @relation(fields: [contractTypeId], references: [id])
  contractTypeId String

  startDate   DateTime
  endDate     DateTime?
  baseSalary  Decimal   @db.Decimal(12, 2) // sueldo base mensual, CLP
  weeklyHours Int       @default(45)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  generatedDocuments GeneratedDocument[]
  payrollResults     PayrollResult[]
  apsContractProfile ApsContractProfile?

  @@unique([legalEntityId, contractNumber])
}

// ---------------------------------------------------------------------------
// Movimientos del funcionario (EMPLOYEE_EVENT)
//
// Registro histórico e inmutable de todo cambio relevante en la relación
// laboral: contratación, cambios de remuneración, jornada, régimen jurídico,
// centro de costo, cargo, licencias, término, etc. La pantalla de captura NO
// debe escribir directamente sobre Contract/Position: debe crear primero un
// EmployeeEvent (con su detalle en EmployeeEventChange) y, sólo para los
// campos que ya tienen un lugar natural en el modelo actual (sueldo base,
// horas semanales, régimen jurídico — todos en Contract), aplicar el cambio
// sobre el contrato vigente del colaborador. Cambios estructurales (centro de
// costo, cargo, posición) quedan registrados en el historial pero su
// aplicación real sigue haciéndose creando un nuevo Contract, porque Position
// es un catálogo compartido entre colaboradores y no lleva historial propio
// todavía (ver EMPLOYMENT_CONTRACT en el módulo de Contratos).
// ---------------------------------------------------------------------------

model EventType {
  id              String  @id @default(cuid())
  code            String  @unique @db.VarChar(40) // ej. HIRE, PAY_CHANGE, COST_CENTER_CHANGE
  name            String  @db.VarChar(150)
  payrollRelevant Boolean @default(false) // valor por defecto al crear un movimiento de este tipo
  isActive        Boolean @default(true)

  reasons        EventReason[]
  employeeEvents EmployeeEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventReason {
  id   String @id @default(cuid())
  code String @db.VarChar(40)
  name String @db.VarChar(150)

  eventType   EventType @relation(fields: [eventTypeId], references: [id])
  eventTypeId String

  isActive Boolean @default(true)

  employeeEvents EmployeeEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventTypeId, code])
}

enum EmployeeEventStatus {
  APPLIED
  CANCELLED
}

model EmployeeEvent {
  id String @id @default(cuid())

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String

  effectiveDate  DateTime
  sequenceNumber Int // secuencia del movimiento para este colaborador (1, 2, 3, ...)

  eventType     EventType   @relation(fields: [eventTypeId], references: [id])
  eventTypeId   String
  eventReason   EventReason @relation(fields: [eventReasonId], references: [id])
  eventReasonId String

  description       String? @db.VarChar(500)
  documentReference String? @db.VarChar(200)

  // Régimen jurídico vigente al momento del movimiento (snapshot del contrato
  // activo del colaborador en ese instante, no necesariamente el que queda
  // vigente después de aplicar el movimiento).
  laborRegime   LaborRegime? @relation(fields: [laborRegimeId], references: [id])
  laborRegimeId String?

  payrollRelevant Boolean // copiado de EventType.payrollRelevant al crear el movimiento
  retroactive     Boolean // effectiveDate cae en o antes de un período de remuneraciones ya calculado

  status EmployeeEventStatus @default(APPLIED)

  changes      EmployeeEventChange[]
  bankAccounts EmployeeBankAccount[]

  createdBy          String?            @db.VarChar(150)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  apsCareerHistories ApsCareerHistory[]

  @@unique([employeeId, sequenceNumber])
}

// Detalle de un movimiento: permite que un mismo EmployeeEvent modifique más
// de un atributo (ej. una promoción que cambia posición y sueldo base a la
// vez) sin necesitar una fila de historial independiente por cada campo.
model EmployeeEventChange {
  id String @id @default(cuid())

  employeeEvent   EmployeeEvent @relation(fields: [employeeEventId], references: [id], onDelete: Cascade)
  employeeEventId String

  fieldCode      String  @db.VarChar(40) // ej. BASE_SALARY, WEEKLY_HOURS, COST_CENTER, POSITION, LABOR_REGIME, OTHER
  oldValue       String? @db.VarChar(300)
  newValue       String? @db.VarChar(300)
  oldReferenceId String?
  newReferenceId String?
}

// ---------------------------------------------------------------------------
// Datos bancarios del funcionario
//
// Igual que EmployeeAfp/HealthAffiliation: con vigencia histórica, nunca se
// sobrescribe una cuenta existente. Al registrar una nueva cuenta principal
// se cierra automáticamente (effectiveTo = nueva effectiveFrom, status =
// FINISHED) la cuenta principal vigente anterior del mismo colaborador, para
// no perder el dato histórico y saber con precisión desde cuándo debe usarse
// cada cuenta para el pago de remuneraciones.
// ---------------------------------------------------------------------------

model Bank {
  id            String    @id @default(cuid())
  code          String    @unique @db.VarChar(10)
  name          String    @unique @db.VarChar(100)
  regulatorCode String?   @db.VarChar(20) // código SBIF/CMF
  isActive      Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  bankAccounts EmployeeBankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccountType {
  id       String  @id @default(cuid())
  code     String  @unique @db.VarChar(30) // ej. CUENTA_CORRIENTE, CUENTA_VISTA, CUENTA_RUT
  name     String  @db.VarChar(100)
  isActive Boolean @default(true)

  bankAccounts EmployeeBankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentMethod {
  id       String  @id @default(cuid())
  code     String  @unique @db.VarChar(30) // ej. BANK_TRANSFER, CASH, CHECK, PAYROLL_CARD
  name     String  @db.VarChar(100)
  isActive Boolean @default(true)

  bankAccounts EmployeeBankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeBankAccount {
  id String @id @default(cuid())

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String

  bank            Bank            @relation(fields: [bankId], references: [id])
  bankId          String
  accountType     BankAccountType @relation(fields: [accountTypeId], references: [id])
  accountTypeId   String
  paymentMethod   PaymentMethod   @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId String

  accountNumber     String @db.VarChar(30)
  accountHolderName String @db.VarChar(150)
  accountHolderRut  String @db.VarChar(12)
  currencyCode      String @default("CLP") @db.VarChar(3)

  isPrimary     Boolean           @default(true)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        AffiliationStatus @default(ACTIVE)

  // Movimiento que originó el cambio, cuando corresponde (ej. registrado
  // desde el módulo de Movimientos con evento BANK_ACCOUNT_CHANGE).
  employeeEvent   EmployeeEvent? @relation(fields: [employeeEventId], references: [id])
  employeeEventId String?

  notes String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Ausentismo (vacaciones, licencias)
// ---------------------------------------------------------------------------

enum LeaveType {
  VACATION
  SICK_LEAVE
  PARENTAL
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Leave {
  id         String      @id @default(cuid())
  employee   Employee    @relation(fields: [employeeId], references: [id])
  employeeId String
  type       LeaveType
  status     LeaveStatus @default(PENDING)
  startDate  DateTime
  endDate    DateTime
  days       Int
  reason     String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Catálogos previsionales (Chile)
// ---------------------------------------------------------------------------

model AfpEntity {
  id            String    @id @default(cuid())
  name          String    @unique // ej. "Capital", "Cuprum", "Habitat", "Modelo", "PlanVital", "ProVida", "Uno"
  workerRate    Decimal   @db.Decimal(5, 2) // % total cotización trabajador (10% + comisión), referencial para el catálogo
  isActive      Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  affiliations   EmployeeAfp[]
  pensionSavings EmployeePensionSaving[] // también puede ser la institución de un producto voluntario (APV/CAV/etc.)
}

enum HealthInstitutionType {
  FONASA
  ISAPRE
}

model HealthInstitution {
  id            String                @id @default(cuid())
  name          String                @unique // "Fonasa", "Banmédica", "Colmena", "Cruz Blanca", etc.
  type          HealthInstitutionType
  isActive      Boolean               @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  affiliations HealthAffiliation[]
}

// Mutualidad de empleadores (Ley 16.744): ACHS, IST, Mutual de Seguridad, etc.
// La tasa adicional diferenciada NO vive aquí: depende de la empresa y su
// evaluación de siniestralidad (D.S. 67), por lo que se modelará en una tabla
// de afiliación empresa-mutualidad separada, en una etapa posterior.
model Mutuality {
  id            String    @id @default(cuid())
  code          String    @unique @db.VarChar(20)
  rut           String    @db.VarChar(12)
  legalName     String    @db.VarChar(150) // razón social
  tradeName     String?   @db.VarChar(100) // nombre de fantasía
  address       String?   @db.VarChar(200)
  phone         String?   @db.VarChar(30)
  email         String?   @db.VarChar(150)
  website       String?   @db.VarChar(200)
  previredCode  String?   @db.VarChar(20)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Caja de Compensación de Asignación Familiar (CCAF): Los Andes, La Araucana, etc.
// La afiliación de la empresa y los productos/créditos del trabajador se
// modelarán en tablas separadas, en una etapa posterior.
model Ccaf {
  id            String    @id @default(cuid())
  code          String    @unique @db.VarChar(20)
  rut           String    @db.VarChar(12)
  legalName     String    @db.VarChar(150)
  tradeName     String?   @db.VarChar(100)
  address       String?   @db.VarChar(200)
  phone         String?   @db.VarChar(30)
  email         String?   @db.VarChar(150)
  website       String?   @db.VarChar(200)
  previredCode  String?   @db.VarChar(20)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AffiliationStatus {
  ACTIVE
  FINISHED
  PENDING
}

// Afiliación previsional obligatoria del trabajador a una AFP, con vigencia histórica.
// No se sobrescribe al cambiar de AFP: se cierra effectiveTo del registro anterior y se
// crea uno nuevo, para poder recalcular liquidaciones históricas con los datos correctos
// del período (AFP, comisión, fondo, etc. vigentes en ese momento).
model EmployeeAfp {
  id         String    @id @default(cuid())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  employeeId String
  afp        AfpEntity @relation(fields: [afpId], references: [id])
  afpId      String

  affiliationDate DateTime // fecha_afiliacion_sistema: primera afiliación de la persona al sistema de AFP
  afpJoinDate     DateTime // fecha_incorporacion_afp: fecha en que se incorporó a esta AFP en particular
  effectiveFrom   DateTime // desde cuándo se usa esta AFP para el cálculo de remuneraciones
  effectiveTo     DateTime? // null mientras esté vigente

  status   AffiliationStatus @default(ACTIVE)
  fundType String?           @db.Char(1) // tipo_fondo: A/B/C/D/E

  mandatoryContributionPct  Decimal  @default(10.000) @db.Decimal(6, 3) // cotización obligatoria, ley
  afpCommissionPct          Decimal? @db.Decimal(6, 3) // comisión de la AFP vigente al momento de esta afiliación
  additionalContributionPct Decimal? @db.Decimal(6, 3) // cotización adicional, si corresponde

  heavyWork    Boolean  @default(false) // trabajo pesado
  heavyWorkPct Decimal? @db.Decimal(5, 2) // 2.00 / 4.00

  notes String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PensionProductType {
  APV // Ahorro Previsional Voluntario
  CAV // Cuenta de Ahorro Voluntario (Cuenta 2)
  COTIZACION_VOLUNTARIA
  DEPOSITO_CONVENIDO
}

enum ContributionMode {
  MONTO
  PORCENTAJE
}

enum PensionSavingStatus {
  ACTIVE
  SUSPENDED
  FINISHED
}

// Productos de ahorro previsional voluntario, independientes de la afiliación obligatoria.
// Un trabajador puede tener más de uno simultáneamente (ej. APV + Cuenta 2), incluso en
// una institución distinta de su AFP de afiliación obligatoria.
model EmployeePensionSaving {
  id            String             @id @default(cuid())
  employee      Employee           @relation(fields: [employeeId], references: [id])
  employeeId    String
  productType   PensionProductType
  institution   AfpEntity          @relation(fields: [institutionId], references: [id])
  institutionId String

  taxRegime        String?          @db.Char(1) // A/B, solo aplica a APV
  contributionMode ContributionMode
  amount           Decimal?         @db.Decimal(15, 2) // si contributionMode = MONTO
  percentage       Decimal?         @db.Decimal(7, 4) // si contributionMode = PORCENTAJE
  currency         String?          @default("CLP") @db.VarChar(10)
  fundType         String?          @db.Char(1)

  effectiveFrom    DateTime
  effectiveTo      DateTime?
  status           PensionSavingStatus @default(ACTIVE)
  payrollDeduction Boolean             @default(true) // descuento por planilla
  contractNumber   String?             @db.VarChar(50)
  notes            String?             @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Afiliación de salud (Fonasa/Isapre) del trabajador, también con vigencia histórica:
// se registra la fecha en que la persona cambió de institución o de plan.
model HealthAffiliation {
  id                  String            @id @default(cuid())
  employee            Employee          @relation(fields: [employeeId], references: [id])
  employeeId          String
  healthInstitution   HealthInstitution @relation(fields: [healthInstitutionId], references: [id])
  healthInstitutionId String

  planUfValue   Decimal?          @db.Decimal(10, 4) // valor del plan en UF, si es Isapre
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        AffiliationStatus @default(ACTIVE)
  notes         String?           @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tabla de impuesto único de segunda categoría (tramos en UTM)
model TaxBracket {
  id           String   @id @default(cuid())
  validFrom    DateTime // vigencia del tramo, para permitir historicidad de la tabla del SII
  fromUtm      Decimal  @db.Decimal(10, 4)
  toUtm        Decimal? @db.Decimal(10, 4) // null = sin tope (tramo superior)
  factor       Decimal  @db.Decimal(6, 4) // factor de cálculo
  deductionUtm Decimal  @db.Decimal(10, 4) // cantidad a rebajar, en UTM
}

// Indicadores económicos mensuales requeridos para el cálculo de remuneraciones
model EconomicIndicator {
  id             String   @id @default(cuid())
  period         DateTime // primer día del mes al que aplica, ej. 2026-09-01
  ufValue        Decimal  @db.Decimal(10, 2) // valor UF usado para el cálculo del período
  utmValue       Decimal  @db.Decimal(10, 2)
  minWage        Decimal  @db.Decimal(10, 2) // ingreso mínimo mensual
  afpHealthCapUf Decimal  @db.Decimal(10, 2) // tope imponible AFP/salud del período, en UF (verificar valor vigente en Previred)

  @@unique([period])
}

// ---------------------------------------------------------------------------
// Remuneraciones
// ---------------------------------------------------------------------------

enum PayrollPeriodStatus {
  OPEN
  CALCULATED
  CLOSED
  PAID
}

model PayrollPeriod {
  id          String              @id @default(cuid())
  month       Int // 1-12
  year        Int
  status      PayrollPeriodStatus @default(OPEN)
  paymentDate DateTime?
  runs        PayrollRun[]
  results     PayrollResult[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([month, year])
}

enum ConceptType {
  EARNING // haber
  DEDUCTION // descuento
}

enum ConceptCategory {
  TAXABLE // imponible y tributable
  NON_TAXABLE // no imponible (ej. colación, movilización)
  LEGAL_DEDUCTION // descuento legal (AFP, salud, AFC, impuesto)
  OTHER_DEDUCTION // descuento voluntario/otro
}

model PayrollConcept {
  id       String                @id @default(cuid())
  code     String                @unique // ej. "SUELDO_BASE", "GRATIFICACION", "AFP", "SALUD", "AFC", "IMPUESTO_UNICO"
  name     String
  type     ConceptType
  category ConceptCategory
  isSystem Boolean               @default(false) // conceptos calculados automáticamente por el sistema
  details  PayrollResultDetail[]
  formulas PayrollFormula[]
}

// ---------------------------------------------------------------------------
// Resultados de nómina versionados (inspirado en RT/WPBP/BT de SAP)
//
// Regla central: un PayrollResult ya calculado NUNCA se edita ni se
// sobrescribe. Cada corrida de cálculo (PayrollRun) crea, por cada
// colaborador, un PayrollResult nuevo con resultSequence+1; si ya existía un
// resultado vigente (isCurrent=true) para ese colaborador+período, éste pasa
// a SUPERSEDED/isCurrent=false y el nuevo queda enlazado vía parentResultId.
// Nunca se borra el anterior: es la única forma de saber qué se calculó
// antes, cuánta fue la diferencia, y de auditar la corrección.
// ---------------------------------------------------------------------------

enum PayrollRunType {
  REGULAR
  CORRECTION
  RETROACTIVE // reservado: no hay hoy motor de recálculo retroactivo de períodos pasados
  OFF_CYCLE
}

enum PayrollRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model PayrollRun {
  id               String           @id @default(cuid())
  payrollPeriod    PayrollPeriod    @relation(fields: [payrollPeriodId], references: [id])
  payrollPeriodId  String
  runNumber        Int
  runType          PayrollRunType
  correctionNumber Int?
  description      String?          @db.VarChar(255)
  calculationDate  DateTime?
  status           PayrollRunStatus @default(RUNNING)

  parent      PayrollRun?  @relation("RunToParent", fields: [parentRunId], references: [id])
  parentRunId String?
  children    PayrollRun[] @relation("RunToParent")

  results PayrollResult[]

  createdBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())

  @@unique([payrollPeriodId, runNumber])
}

enum PayrollResultStatus {
  CALCULATED
  SUPERSEDED
  FINAL
  CANCELLED
}

// Sólo FULL está implementado (recalcula todo desde cero). DIFFERENCE queda
// reservado para cuando exista un modo de corrección que sólo calcule el
// delta contra el resultado anterior en vez de recalcular todo.
enum PayrollCalculationMode {
  FULL
  DIFFERENCE
}

model PayrollResult {
  id String @id @default(cuid())

  payrollRun      PayrollRun    @relation(fields: [payrollRunId], references: [id])
  payrollRunId    String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  payrollPeriodId String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  employeeId      String
  contract        Contract      @relation(fields: [contractId], references: [id])
  contractId      String

  resultSequence Int // 1, 2, 3... por colaborador+período; nunca se reutiliza ni se sobrescribe
  resultType     PayrollRunType

  parent         PayrollResult?  @relation("ResultToParent", fields: [parentResultId], references: [id])
  parentResultId String?
  children       PayrollResult[] @relation("ResultToParent")

  effectiveDate   DateTime?
  calculationDate DateTime
  calculationMode PayrollCalculationMode @default(FULL)
  currencyCode    String                 @default("CLP") @db.VarChar(3)

  totalEarnings      Decimal @default(0) @db.Decimal(18, 2)
  taxableEarnings    Decimal @default(0) @db.Decimal(18, 2)
  nonTaxableEarnings Decimal @default(0) @db.Decimal(18, 2)

  totalDeductions      Decimal @default(0) @db.Decimal(18, 2)
  totalLegalDeductions Decimal @default(0) @db.Decimal(18, 2)
  totalOtherDeductions Decimal @default(0) @db.Decimal(18, 2)

  totalTaxable     Decimal @default(0) @db.Decimal(18, 2) // base impuesto único
  totalPensionable Decimal @default(0) @db.Decimal(18, 2) // base tope AFP
  totalHealthBase  Decimal @default(0) @db.Decimal(18, 2) // base tope salud

  netAmount         Decimal  @default(0) @db.Decimal(18, 2)
  previousNetAmount Decimal? @db.Decimal(18, 2) // líquido del resultado anterior, si es una corrección
  differenceAmount  Decimal? @db.Decimal(18, 2) // netAmount - previousNetAmount

  status    PayrollResultStatus @default(CALCULATED)
  isCurrent Boolean             @default(true) // sólo un resultado por colaborador+período puede ser el vigente

  details    PayrollResultDetail[]
  employment PayrollResultEmployment?

  createdBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())

  @@unique([employeeId, payrollPeriodId, resultSequence])
}

// De dónde salió el monto de un concepto calculado. Hoy el motor sólo
// produce CONTRACT (sueldo base, tal cual está en el contrato) y
// SYSTEM_CALCULATION (gratificación, AFP, salud, AFC, impuesto único); el
// resto queda declarado para cuando existan movimientos variables,
// ausencias o correcciones manuales que alimenten al cálculo.
enum PayrollDetailOrigin {
  CONTRACT
  PERSON_MASTER
  RECURRING_MOVEMENT
  VARIABLE_MOVEMENT
  ABSENCE
  ATTENDANCE
  SYSTEM_CALCULATION
  RETROACTIVE
  MANUAL
  CORRECTION
}

// Equivalente conceptual a la RT (Results Table) de SAP: un concepto
// calculado dentro de un PayrollResult. code/name/type se congelan aparte
// del FK para que el detalle histórico no cambie si el concepto se
// renombra después.
model PayrollResultDetail {
  id              String        @id @default(cuid())
  payrollResult   PayrollResult @relation(fields: [payrollResultId], references: [id], onDelete: Cascade)
  payrollResultId String

  concept     PayrollConcept @relation(fields: [conceptId], references: [id])
  conceptId   String
  conceptCode String         @db.VarChar(30)
  conceptName String         @db.VarChar(200)
  conceptType ConceptType

  sequence   Int?
  quantity   Decimal? @db.Decimal(18, 6)
  rate       Decimal? @db.Decimal(18, 6)
  baseAmount Decimal? @db.Decimal(18, 2)
  amount     Decimal  @db.Decimal(18, 2)

  taxable             Boolean @default(false)
  pensionable         Boolean @default(false)
  healthTaxable       Boolean @default(false)
  unemploymentTaxable Boolean @default(false)
  incomeTaxable       Boolean @default(false)
  employerCost        Boolean @default(false)

  origin         PayrollDetailOrigin?
  sourceRecordId String?

  createdAt DateTime @default(now())
}

// Fotografía contractual/organizacional usada para este cálculo específico
// (inspirada en WPBP de SAP): una liquidación histórica nunca debe
// depender de consultar la ficha/posición ACTUAL del colaborador. Los ids
// de organización se guardan como texto suelto (sin relación Prisma) junto
// a su nombre ya congelado — a propósito, para no bloquear con FK el
// borrado futuro de un centro de costo/cargo antiguo, y para no depender de
// un join para mostrar la liquidación.
model PayrollResultEmployment {
  id              String        @id @default(cuid())
  payrollResult   PayrollResult @relation(fields: [payrollResultId], references: [id], onDelete: Cascade)
  payrollResultId String        @unique

  legalEntityId    String?
  legalEntityName  String? @db.VarChar(150)
  costCenterId     String?
  costCenterName   String? @db.VarChar(150)
  departmentId     String?
  departmentName   String? @db.VarChar(150)
  positionId       String?
  positionTitle    String? @db.VarChar(200)
  contractTypeId   String?
  contractTypeName String? @db.VarChar(100)

  weeklyHours Decimal? @db.Decimal(8, 2)
  baseSalary  Decimal? @db.Decimal(18, 2)

  validFrom DateTime?
  validTo   DateTime? // hoy siempre = fin del período; sin soporte de tramos intra-mes todavía

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Motor de Reglas de Remuneraciones ("Define Cálculo Nómina")
//
// Arquitectura híbrida: el motor de cálculo (fuera de este archivo, en
// payroll-formulas/formula-engine.ts) sólo sabe interpretar un lenguaje de
// expresiones limitado y seguro (sin eval, sin código arbitrario). Todo lo
// que cambia con la normativa o la política de la empresa —fórmulas,
// porcentajes, tramos— vive aquí como configuración versionada.
//
// Regla central: una fórmula que ya salió de DRAFT nunca se edita ni se
// borra. Un cambio siempre crea una nueva versión (mismo conceptId, version
// + 1); la anterior se cierra (effectiveTo, status = INACTIVE) al activar la
// siguiente, igual que el resto de los históricos de este sistema
// (EmployeeAfp, EmployeeBankAccount, Contract).
// ---------------------------------------------------------------------------

enum PayrollFormulaStatus {
  DRAFT
  TESTING
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  INACTIVE
  REJECTED
}

enum PayrollVariableSource {
  EMPLOYEE
  CONTRACT
  INDICATOR
  PARAMETER
  TABLE
  SYSTEM
}

// Catálogo documental de las variables que el motor pone a disposición de
// las fórmulas (ej. SUELDO_BASE, HORAS_SEMANALES, UF). No valida en tiempo
// de guardado que la fórmula sólo use variables existentes en este catálogo;
// eso lo hace el simulador al ejecutar la fórmula contra variables reales.
model PayrollVariable {
  id          String                @id @default(cuid())
  code        String                @unique @db.VarChar(50)
  name        String                @db.VarChar(150)
  description String?               @db.VarChar(300)
  source      PayrollVariableSource
  isActive    Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollParameter {
  id          String  @id @default(cuid())
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(150)
  description String? @db.VarChar(300)
  isActive    Boolean @default(true)

  values PayrollParameterValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Valor de un parámetro con vigencia histórica (ej. PORC_RESPONSABILIDAD
// 0.10 desde 01-01-2026, 0.12 desde 01-01-2027) para poder cambiar un
// porcentaje sin tocar la fórmula que lo usa.
model PayrollParameterValue {
  id            String           @id @default(cuid())
  parameter     PayrollParameter @relation(fields: [parameterId], references: [id])
  parameterId   String
  value         Decimal          @db.Decimal(14, 6)
  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
}

model PayrollTable {
  id       String  @id @default(cuid())
  code     String  @unique @db.VarChar(50)
  name     String  @db.VarChar(150)
  isActive Boolean @default(true)

  rows PayrollTableRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fila de tramo (ej. tabla de impuesto/tramos de asignación): LOOKUP(TABLA,
// valor) busca la fila donde fromValue <= valor <= toValue (o sin tope si
// toValue es nulo) y entrega resultValue.
model PayrollTableRow {
  id            String       @id @default(cuid())
  table         PayrollTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableId       String
  fromValue     Decimal      @db.Decimal(14, 4)
  toValue       Decimal?     @db.Decimal(14, 4)
  resultValue   Decimal      @db.Decimal(14, 6)
  effectiveFrom DateTime
  effectiveTo   DateTime?
}

// La fórmula versionada asociada a un PayrollConcept. Nunca se edita una vez
// fuera de DRAFT: se crea una nueva versión (conceptId, version+1).
model PayrollFormula {
  id String @id @default(cuid())

  concept   PayrollConcept @relation(fields: [conceptId], references: [id])
  conceptId String
  version   Int

  formulaExpression String  @db.VarChar(2000) // DSL, ej. "SUELDO_BASE * PORC_RESPONSABILIDAD"
  condition         String? @db.VarChar(1000) // DSL booleana opcional, ej. "CATEGORIA_APS = 1"

  // Alcance opcional: nulo = aplica a todos los régimenes/entidades.
  laborRegime   LaborRegime? @relation(fields: [laborRegimeId], references: [id])
  laborRegimeId String?
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id])
  legalEntityId String?

  priority      Int                  @default(500) // orden de cálculo (menor = antes)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        PayrollFormulaStatus @default(DRAFT)

  createdBy  String?   @db.VarChar(150)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedBy String?   @db.VarChar(150)
  approvedAt DateTime?

  @@unique([conceptId, version])
}

// ---------------------------------------------------------------------------
// Motor de Documentos Contractuales ("Gestión Contractual")
//
// Separa la lógica contractual (qué documento corresponde generar) de la
// generación física del documento. La ContractMatrix sólo enruta: decide qué
// ContractTemplate usar según tipo de documento + régimen jurídico + tipo de
// contrato + prioridad. El contenido legal pesado vive en
// ContractTemplateVersion y ClauseVersion, que nunca se editan una vez
// publicadas — todo cambio crea una nueva versión, igual que PayrollFormula.
// La plantilla es un shell HTML con un placeholder {{clauses}} que el motor
// reemplaza por las cláusulas asignadas a la matriz (MatrixClause, en orden),
// cada una resuelta desde su versión PUBLISHED vigente a la fecha del
// documento. Un documento generado congela el HTML final y el valor de cada
// token usado (GeneratedDocumentToken) junto con su hash SHA-256: un
// documento ya generado nunca se re-renderiza con datos actuales, aunque el
// colaborador cambie de sueldo, cargo o dirección después.
// ---------------------------------------------------------------------------

enum ContractMatrixStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

// La matriz sólo decide qué plantilla usar; no contiene el texto del
// documento. Editable sólo en DRAFT: para reemplazar una matriz ACTIVA hay
// que desactivarla y crear una nueva (mismo espíritu que PayrollFormula,
// pero sin el ciclo de aprobación completo porque el riesgo real está en el
// contenido de la plantilla/cláusulas, no en esta regla de enrutamiento).
model ContractMatrix {
  id           String @id @default(cuid())
  code         String @db.VarChar(80)
  name         String @db.VarChar(200)
  documentType String @db.VarChar(30) // CONTRATO | ANEXO | CERTIFICADO (validado en el DTO)

  legalRegime    LaborRegime?  @relation(fields: [legalRegimeId], references: [id])
  legalRegimeId  String?
  contractType   ContractType? @relation(fields: [contractTypeId], references: [id])
  contractTypeId String?

  template   ContractTemplate @relation(fields: [templateId], references: [id])
  templateId String

  priority Int @default(500) // a igual alcance, menor valor gana

  // Reservados para una etapa posterior (aprobación de documentos, firma
  // electrónica, disparo automático desde EmployeeEvent): no hay flujo
  // implementado todavía, se guardan para no requerir una migración futura.
  automaticGeneration Boolean @default(false)
  requiresApproval    Boolean @default(false)
  requiresSignature   Boolean @default(false)

  validFrom DateTime
  validTo   DateTime?
  status    ContractMatrixStatus @default(DRAFT)

  clauses            MatrixClause[]
  generatedDocuments GeneratedDocument[]

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model ContractTemplate {
  id           String        @id @default(cuid())
  code         String        @unique @db.VarChar(80)
  name         String        @db.VarChar(200)
  documentType String        @db.VarChar(30)
  status       OrgUnitStatus @default(ACTIVE)

  versions ContractTemplateVersion[]
  matrices ContractMatrix[]

  createdBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contenido versionado de una plantilla: HTML con tokens ({{namespace.path}},
// pipes de formato, bloques {{#if}}) y el placeholder {{clauses}} que expande
// las cláusulas de la matriz. Nunca se edita fuera de DRAFT.
model ContractTemplateVersion {
  id            String                @id @default(cuid())
  template      ContractTemplate      @relation(fields: [templateId], references: [id])
  templateId    String
  versionNumber Int
  content       String                @db.Text
  status        TemplateVersionStatus @default(DRAFT)
  validFrom     DateTime?
  validTo       DateTime?
  publishedAt   DateTime?
  publishedBy   String?               @db.VarChar(150)

  generatedDocuments GeneratedDocument[]

  createdBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())

  @@unique([templateId, versionNumber])
}

enum ClauseVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// Bloque de contenido reutilizable (ej. "Identificación de las partes",
// "Remuneración", "Jornada"). Una misma cláusula puede usarse en varias
// matrices; cada matriz decide el orden vía MatrixClause.sequence.
model Clause {
  id          String        @id @default(cuid())
  code        String        @unique @db.VarChar(80)
  name        String        @db.VarChar(200)
  description String?       @db.VarChar(500)
  status      OrgUnitStatus @default(ACTIVE)

  versions      ClauseVersion[]
  matrixClauses MatrixClause[]

  createdBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contenido versionado de una cláusula (HTML con tokens y {{#if}}). Nunca se
// edita fuera de DRAFT; igual regla de vigencia que ContractTemplateVersion.
model ClauseVersion {
  id            String              @id @default(cuid())
  clause        Clause              @relation(fields: [clauseId], references: [id])
  clauseId      String
  versionNumber Int
  content       String              @db.Text
  status        ClauseVersionStatus @default(DRAFT)
  validFrom     DateTime?
  validTo       DateTime?
  publishedAt   DateTime?
  publishedBy   String?             @db.VarChar(150)

  createdBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())

  @@unique([clauseId, versionNumber])
}

// Asigna una cláusula a una matriz, en el orden en que debe aparecer dentro
// del placeholder {{clauses}} de la plantilla.
model MatrixClause {
  id        String         @id @default(cuid())
  matrix    ContractMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  matrixId  String
  clause    Clause         @relation(fields: [clauseId], references: [id])
  clauseId  String
  sequence  Int
  mandatory Boolean        @default(true)

  @@unique([matrixId, clauseId])
}

// Catálogo documental de los tokens que el motor pone a disposición de
// plantillas y cláusulas (ej. employee.fullName, contract.startDate,
// compensation.baseSalary). Igual que PayrollVariable: no valida en tiempo de
// guardado que una plantilla sólo use tokens de este catálogo; eso lo hace el
// endpoint de validación de plantilla. La resolución real vive en código
// (engine/token-resolvers.ts), no en estas columnas.
model DocumentTokenDefinition {
  id           String  @id @default(cuid())
  code         String  @unique @db.VarChar(100) // ej. "employee.fullName"
  namespace    String  @db.VarChar(50) // ej. "employee", "contract", "company"
  name         String  @db.VarChar(150)
  dataType     String  @db.VarChar(20) // STRING | DATE | DECIMAL | BOOLEAN
  description  String? @db.VarChar(300)
  sourceEntity String? @db.VarChar(50) // documental, ej. "PERSON", "CONTRACT"
  required     Boolean @default(false)
  sensitive    Boolean @default(false)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GeneratedDocumentStatus {
  GENERATED
  CANCELLED
}

// Documento efectivamente emitido: congela el HTML final ya renderizado (con
// los tokens resueltos y las cláusulas expandidas) y su hash SHA-256. Nunca
// se regenera con datos actuales — si el colaborador cambia de sueldo, cargo
// o dirección después, este documento conserva los valores vigentes al
// momento en que se generó (ver GeneratedDocumentToken).
model GeneratedDocument {
  id             String @id @default(cuid())
  documentNumber String @unique @db.VarChar(40) // ej. "CTR-2026-000123"

  matrix             ContractMatrix          @relation(fields: [matrixId], references: [id])
  matrixId           String
  matrixCodeSnapshot String                  @db.VarChar(80)
  templateVersion    ContractTemplateVersion @relation(fields: [templateVersionId], references: [id])
  templateVersionId  String

  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  contract   Contract @relation(fields: [contractId], references: [id])
  contractId String

  documentType  String   @db.VarChar(30)
  documentDate  DateTime
  effectiveDate DateTime

  generatedAt DateTime @default(now())
  generatedBy String?  @db.VarChar(150)

  status GeneratedDocumentStatus @default(GENERATED)

  content     String @db.Text // HTML final, ya renderizado y congelado
  contentHash String @db.VarChar(64) // sha256 hex del contenido

  cancelledAt  DateTime?
  cancelledBy  String?   @db.VarChar(150)
  cancelReason String?   @db.VarChar(300)

  tokens GeneratedDocumentToken[]
}

// Valor congelado de cada token usado al generar el documento: evidencia de
// exactamente qué dato se usó y de dónde salió, sin depender de que el
// registro de origen no cambie después.
model GeneratedDocumentToken {
  id             String            @id @default(cuid())
  document       GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId     String
  tokenCode      String            @db.VarChar(100)
  rawValue       String?           @db.VarChar(500)
  formattedValue String?           @db.VarChar(500)
  sourceEntity   String?           @db.VarChar(50)
  sourceRecordId String?
}

// ---------------------------------------------------------------------------
// Carrera Funcionaria APS — Ley N°19.378 (Estatuto de Atención Primaria de
// Salud Municipal) y su Reglamento de Carrera Funcionaria (Decreto 1.889).
//
// Ver docs/ley-19378-modelo-fisico.md para la especificación completa y las
// decisiones de integración (qué se reutiliza de LegalEntity/LaborRegime/
// Contract/PayrollConcept/PayrollFormula en vez de duplicarlo).
//
// Convención: Nómina no interpreta esta ley — este submódulo calcula la
// carrera funcionaria y deja su resultado en ApsContractProfile; de ahí en
// adelante Nómina lo consume igual que cualquier otro régimen, vía
// PayrollConcept/PayrollFormula ya existentes filtrados por
// laborRegimeId = LEY_19378.
// ---------------------------------------------------------------------------

enum ApsAdministrativeEntityType {
  MUNICIPALITY
  MUNICIPAL_CORPORATION
  NON_PROFIT_ADMINISTRATOR
  OTHER_LEGAL_ENTITY
}

enum ApsUrbanRural {
  URBAN
  RURAL
}

enum ApsBienniumStatus {
  IN_PROGRESS
  COMPLETED
  RECOGNIZED
  SUSPENDED
  ANNULLED
}

enum ApsServiceExclusionType {
  UNPAID_LEAVE
  UNRECOGNIZED_SERVICE
  SERVICE_INTERRUPTION
  OTHER
}

enum ApsAcademicStatus {
  IN_PROGRESS
  COMPLETED
  RECOGNIZED
  REJECTED
}

enum ApsTrainingParticipationStatus {
  REGISTERED
  IN_PROGRESS
  APPROVED
  FAILED
  RECOGNIZED
  REJECTED
}

enum ApsCareerEventType {
  CAREER_ENTRY
  CATEGORY_CHANGE
  BIENNIUM_RECOGNITION
  TRAINING_RECOGNITION
  LEVEL_CHANGE
  TITLE_RECOGNITION
  POSTGRADUATE_RECOGNITION
  MERIT_EVALUATION
  MERIT_ASSIGNMENT
  POSITION_CHANGE
  RESPONSIBILITY_ASSIGNMENT
  CAREER_RECALCULATION
  RECTIFICATION
}

enum ApsProgramStatus {
  DRAFT
  APPROVED
  IN_EXECUTION
  CLOSED
}

// ---- Dominio 1: configuración y parámetros legales -------------------------

// Genérico a propósito: no es "de la Ley 19.378", es del sistema, para que
// otros regímenes (Ley 19.070, Ley 19.464) lo reutilicen sin tabla nueva.
model LegalParameter {
  id            String       @id @default(cuid())
  laborRegime   LaborRegime? @relation(fields: [laborRegimeId], references: [id])
  laborRegimeId String?

  parameterCode String   @db.VarChar(80) // ej. LAW_19378.MAX_BIENNIUMS
  parameterName String   @db.VarChar(200)
  numericValue  Decimal? @db.Decimal(18, 6)
  textValue     String?  @db.VarChar(300)
  booleanValue  Boolean?
  category      String?  @db.VarChar(60)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  legalReference String? @db.VarChar(200)
  articleNumber  String? @db.VarChar(20)
  version        Int
  isActive       Boolean @default(true)

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Dominio 2: entidad administradora y establecimientos ------------------

// Extiende LegalEntity (ya existente) con la calificación de "administradora
// de salud municipal" en vez de duplicar razón social/RUT/representante.
model ApsAdministrativeEntityProfile {
  id                    String                      @id @default(cuid())
  legalEntity           LegalEntity                 @relation(fields: [legalEntityId], references: [id])
  legalEntityId         String                      @unique
  entityType            ApsAdministrativeEntityType
  municipalityCommune   Commune?                    @relation(fields: [municipalityCommuneId], references: [id])
  municipalityCommuneId String?
  healthService         ApsHealthService?           @relation(fields: [healthServiceId], references: [id])
  healthServiceId       String?
  region                Region?                     @relation(fields: [regionId], references: [id])
  regionId              String?

  effectiveFrom DateTime
  effectiveTo   DateTime?
  active        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApsHealthService {
  id       String  @id @default(cuid())
  code     String  @unique @db.VarChar(20)
  name     String  @db.VarChar(150)
  region   Region? @relation(fields: [regionId], references: [id])
  regionId String?
  isActive Boolean @default(true)

  administrativeEntityProfiles ApsAdministrativeEntityProfile[]
  healthFacilities             ApsHealthFacility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApsFacilityType {
  id       String  @id @default(cuid())
  code     String  @unique @db.VarChar(30) // CESFAM, CECOSF, POSTA_RURAL, SAPU, SAR, COSAM, CONSULTORIO, DIRECCION_SALUD, OTRO
  name     String  @db.VarChar(150)
  isActive Boolean @default(true)

  facilities ApsHealthFacility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApsHealthFacility {
  id                     String            @id @default(cuid())
  administrativeEntity   LegalEntity       @relation(fields: [administrativeEntityId], references: [id])
  administrativeEntityId String
  code                   String            @unique @db.VarChar(30)
  name                   String            @db.VarChar(200)
  facilityType           ApsFacilityType   @relation(fields: [facilityTypeId], references: [id])
  facilityTypeId         String
  urbanRural             ApsUrbanRural
  address                String?           @db.VarChar(300)
  commune                Commune           @relation(fields: [communeId], references: [id])
  communeId              String
  healthService          ApsHealthService? @relation(fields: [healthServiceId], references: [id])
  healthServiceId        String?
  division               Division?         @relation(fields: [divisionId], references: [id])
  divisionId             String?

  effectiveFrom DateTime
  effectiveTo   DateTime?
  active        Boolean   @default(true)

  staffingPositions         ApsStaffingPosition[]
  employeeAssignments       ApsEmployeeAssignment[]
  responsibilityAssignments ApsResponsibilityAssignment[]
  difficultPerformances     ApsDifficultPerformanceFacility[]
  zoneAssignments           EmployeeApsZoneAssignment[]
  contractProfiles          ApsContractProfile[]

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Dominio 3: categorías, profesiones y carrera ---------------------------

// Las 6 categorías (A-F) son datos, no un enum: nunca se codifican en el
// algoritmo, así una entidad administradora puede ajustarlas sin migración.
model ApsEmployeeCategory {
  id                   String    @id @default(cuid())
  code                 String    @unique @db.VarChar(5) // "A".."F"
  name                 String    @db.VarChar(200)
  description          String?   @db.VarChar(500)
  qualificationLevel   String?   @db.VarChar(50)
  professionalRequired Boolean   @default(false)
  minimumSemesters     Int?
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  active               Boolean   @default(true)

  professions                 ApsProfession[]
  careerLevels                ApsCareerLevel[]
  baseSalaryScales            ApsBaseSalaryScale[]
  nationalMinimumSalaries     ApsNationalMinimumBaseSalary[]
  experienceRules             ApsExperienceRule[]
  careers                     ApsCareer[]
  careerHistory               ApsCareerHistory[]
  staffingPositions           ApsStaffingPosition[]
  employeeAssignments         ApsEmployeeAssignment[]
  specialTemporaryAssignments ApsSpecialTemporaryAssignment[]
  trainingProgramItems        ApsMunicipalTrainingProgramItem[]
  contractProfiles            ApsContractProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApsProfession {
  id                        String              @id @default(cuid())
  code                      String              @unique @db.VarChar(40)
  name                      String              @db.VarChar(150)
  category                  ApsEmployeeCategory @relation(fields: [categoryId], references: [id])
  categoryId                String
  professionalTitleRequired Boolean             @default(false)
  minimumSemesters          Int?
  healthRegistryRequired    Boolean             @default(false)
  effectiveFrom             DateTime
  effectiveTo               DateTime?
  active                    Boolean             @default(true)

  postgraduates ApsPostgraduate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Nivel y su puntaje asociado. El sueldo se retira de aquí y vive en
// ApsBaseSalaryScale (separar puntaje de nivel de su valor monetario
// histórico).
model ApsCareerLevel {
  id                     String              @id @default(cuid())
  administrativeEntity   LegalEntity         @relation(fields: [administrativeEntityId], references: [id])
  administrativeEntityId String
  category               ApsEmployeeCategory @relation(fields: [categoryId], references: [id])
  categoryId             String
  levelNumber            Int // 1 a 15 (la carrera parte en 15 y sube hacia 1)
  minimumPoints          Decimal             @db.Decimal(10, 4)
  maximumPoints          Decimal?            @db.Decimal(10, 4) // nulo = sin techo (nivel 1)
  trainingPercentage     Decimal?            @db.Decimal(14, 6)
  experiencePercentage   Decimal?            @db.Decimal(14, 6)

  effectiveFrom DateTime
  effectiveTo   DateTime?
  active        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApsBaseSalaryScale {
  id                     String              @id @default(cuid())
  administrativeEntity   LegalEntity         @relation(fields: [administrativeEntityId], references: [id])
  administrativeEntityId String
  category               ApsEmployeeCategory @relation(fields: [categoryId], references: [id])
  categoryId             String
  careerLevel            Int
  weeklyHours            Int
  amount                 Decimal             @db.Decimal(12, 2)

  effectiveFrom     DateTime
  effectiveTo       DateTime?
  approvalReference String?   @db.VarChar(200)
  active            Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Piso nacional — nunca se reemplaza un valor, se cierra y se agrega uno nuevo.
model ApsNationalMinimumBaseSalary {
  id                   String              @id @default(cuid())
  category             ApsEmployeeCategory @relation(fields: [categoryId], references: [id])
  categoryId           String
  weeklyHoursReference Int
  amount               Decimal             @db.Decimal(12, 2)

  effectiveFrom   DateTime
  effectiveTo     DateTime?
  legalReference  String?   @db.VarChar(200)
  publicationDate DateTime?
  active          Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Maestro de carrera del funcionario — 1:1, siempre hay a lo más una carrera
// activa por funcionario.
model ApsCareer {
  id                     String              @id @default(cuid())
  employee               Employee            @relation(fields: [employeeId], references: [id])
  employeeId             String              @unique
  administrativeEntity   LegalEntity         @relation(fields: [administrativeEntityId], references: [id])
  administrativeEntityId String
  category               ApsEmployeeCategory @relation(fields: [categoryId], references: [id])
  categoryId             String

  currentLevel        Int
  experiencePoints    Decimal @default(0) @db.Decimal(10, 4)
  trainingPoints      Decimal @default(0) @db.Decimal(10, 4)
  totalPoints         Decimal @default(0) @db.Decimal(10, 4)
  recognizedBienniums Int     @default(0)

  careerStartDate    DateTime
  levelEffectiveDate DateTime

  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        String    @default("ACTIVE") @db.VarChar(30) // ACTIVE / SUSPENDED / CLOSED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Hoja de Carrera Funcionaria electrónica: un evento por cada hito relevante.
model ApsCareerHistory {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String

  eventType     ApsCareerEventType
  eventDate     DateTime
  effectiveDate DateTime

  category      ApsEmployeeCategory? @relation(fields: [categoryId], references: [id])
  categoryId    String?
  previousLevel Int?
  newLevel      Int?

  experiencePoints Decimal? @db.Decimal(10, 4)
  trainingPoints   Decimal? @db.Decimal(10, 4)
  totalPoints      Decimal? @db.Decimal(10, 4)
  bienniums        Int?

  resolutionNumber String?   @db.VarChar(60)
  resolutionDate   DateTime?
  description      String?   @db.VarChar(500)

  sourceEntity String? @db.VarChar(60) // nombre de la tabla que originó el evento (sin FK física, source polimórfico)
  sourceId     String?

  employeeEvent   EmployeeEvent? @relation(fields: [employeeEventId], references: [id])
  employeeEventId String?

  createdAt DateTime @default(now())
  createdBy String?  @db.VarChar(150)
}

// ---- Dominio 4: experiencia y bienios (maestro-detalle) ---------------------
//
// ApsBiennium es el MAESTRO (un bienio en curso o reconocido); ApsRecognizedService
// es el DETALLE (cada período de servicio que aporta días a ese bienio).

model ApsLaborInstitution {
  id              String    @id @default(cuid())
  code            String    @unique @db.VarChar(30)
  name            String    @db.VarChar(200)
  institutionType String    @db.VarChar(40) // MUNICIPALITY / HEALTH_SERVICE / MUNICIPAL_CORPORATION / PUBLIC_SERVICE / PRIVATE / OTHER
  aps             Boolean   @default(false)
  publicSector    Boolean   @default(false)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  active          Boolean   @default(true)

  recognizedServices ApsRecognizedService[]

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApsRecognizedService {
  id            String              @id @default(cuid())
  employee      Employee            @relation(fields: [employeeId], references: [id])
  employeeId    String
  institution   ApsLaborInstitution @relation(fields: [institutionId], references: [id])
  institutionId String
  biennium      ApsBiennium?        @relation(fields: [bienniumId], references: [id], onDelete: SetNull)
  bienniumId    String?

  serviceType       String  @db.VarChar(40) // TITULAR, CONTRATA, HONORARIOS, SUPLENCIA
  legalRelationship String? @db.VarChar(40)
  positionName      String? @db.VarChar(150)

  startDate DateTime
  endDate   DateTime?

  calendarDays   Int
  recognizedDays Int
  excludedDays   Int @default(0)

  apsService       Boolean @default(false)
  publicService    Boolean @default(false)
  municipalService Boolean @default(false)

  recognized       Boolean   @default(false)
  recognitionDate  DateTime?
  resolutionNumber String?   @db.VarChar(60)
  resolutionDate   DateTime?
  documentId       String?

  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        String    @default("PENDING") @db.VarChar(30) // PENDING / RECOGNIZED / REJECTED

  exclusions ApsServiceExclusion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApsServiceExclusion {
  id         String               @id @default(cuid())
  employee   Employee             @relation(fields: [employeeId], references: [id])
  employeeId String
  service    ApsRecognizedService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId  String

  exclusionType   ApsServiceExclusionType
  startDate       DateTime
  endDate         DateTime
  days            Int
  affectsBiennium Boolean                 @default(true)
  reason          String?                 @db.VarChar(300)
  legalReference  String?                 @db.VarChar(200)
  documentId      String?

  createdAt DateTime @default(now())
}

model ApsBiennium {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String

  bienniumNumber Int // 1..15 (tope legal, ver ApsExperienceRule)

  periodStartDate DateTime
  periodEndDate   DateTime?

  recognizedServiceDays Int @default(0)
  excludedDays          Int @default(0)

  completionDate   DateTime?
  effectiveDate    DateTime?
  experiencePoints Decimal?  @db.Decimal(10, 4)

  recognitionResolution String?   @db.VarChar(60)
  recognitionDate       DateTime?

  status ApsBienniumStatus @default(IN_PROGRESS)

  recognizedServices ApsRecognizedService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, bienniumNumber])
}

// Puntaje por N° de bienio, parametrizable — nunca codificado en el algoritmo.
model ApsExperienceRule {
  id                     String               @id @default(cuid())
  administrativeEntity   LegalEntity?         @relation(fields: [administrativeEntityId], references: [id])
  administrativeEntityId String?
  category               ApsEmployeeCategory? @relation(fields: [categoryId], references: [id])
  categoryId             String?
  bienniumNumber         Int
  points                 Decimal              @db.Decimal(10, 4)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
}

// ---- Dominio 5: capacitación (maestro-detalle) ------------------------------
//
// ApsEmployeeTrainingYear es el MAESTRO (control anual por funcionario);
// EmployeeApsTraining es el DETALLE (cada curso tomado ese año).

model ApsTrainingType {
  id       String  @id @default(cuid())
  code     String  @unique @db.VarChar(30) // COURSE / INTERNSHIP / WORKSHOP / SEMINAR / DIPLOMA / SPECIALIZATION / MISSION_STUDY / CONGRESS / OTHER
  name     String  @db.VarChar(150)
  isActive Boolean @default(true)

  trainingActivities ApsTrainingActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApsTrainingTechnicalLevel {
  id            String    @id @default(cuid())
  code          String    @unique @db.VarChar(20) // LOW / MEDIUM / HIGH
  name          String    @db.VarChar(100)
  factor        Decimal   @db.Decimal(6, 4)
  effectiveFrom DateTime
  effectiveTo   DateTime?

  trainingActivities ApsTrainingActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tipificación de evaluación de capacitación (pedida explícitamente).
model ApsTrainingEvaluationLevel {
  id            String    @id @default(cuid())
  code          String    @unique @db.VarChar(20) // MINIMUM / MEDIUM / MAXIMUM
  name          String    @db.VarChar(100)
  minimumGrade  Decimal   @db.Decimal(5, 2)
  maximumGrade  Decimal   @db.Decimal(5, 2)
  factor        Decimal   @db.Decimal(6, 4) // 0.4000-1.0000 según reglamento
  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApsTrainingDurationRule {
  id            String    @id @default(cuid())
  minimumHours  Int
  maximumHours  Int? // nulo = sin techo (tramo "80+")
  points        Decimal   @db.Decimal(10, 4)
  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
}

// El curso/estadía en sí — mantenedor "Cursos".
model ApsTrainingActivity {
  id                         String                    @id @default(cuid())
  code                       String                    @unique @db.VarChar(40)
  name                       String                    @db.VarChar(200)
  trainingType               ApsTrainingType           @relation(fields: [trainingTypeId], references: [id])
  trainingTypeId             String
  institution                EducationInstitution      @relation(fields: [institutionId], references: [id])
  institutionId              String
  description                String?                   @db.VarChar(500)
  pedagogicalHours           Int
  technicalLevel             ApsTrainingTechnicalLevel @relation(fields: [technicalLevelId], references: [id])
  technicalLevelId           String
  startDate                  DateTime?
  endDate                    DateTime?
  includedInMunicipalProgram Boolean                   @default(false)
  minsalRecognized           Boolean                   @default(false)
  minimumAttendance          Decimal?                  @db.Decimal(5, 2)
  evaluationRequired         Boolean                   @default(true)

  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        String    @default("DRAFT") @db.VarChar(30) // DRAFT / ACTIVE / INACTIVE

  participations ApsMunicipalTrainingProgramItem[]
  enrollments    EmployeeApsTraining[]

  createdBy String?  @db.VarChar(150)
  updatedBy String?  @db.VarChar(150)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeApsTraining {
  id                 String                  @id @default(cuid())
  employee           Employee                @relation(fields: [employeeId], references: [id])
  employeeId         String
  trainingActivity   ApsTrainingActivity     @relation(fields: [trainingActivityId], references: [id])
  trainingActivityId String
  trainingYear       ApsEmployeeTrainingYear @relation(fields: [trainingYearId], references: [id], onDelete: Cascade)
  trainingYearId     String

  registrationDate     DateTime
  attendancePercentage Decimal? @db.Decimal(5, 2)
  finalGrade           Decimal? @db.Decimal(5, 2)
  approved             Boolean?

  durationPoints   Decimal? @db.Decimal(10, 4)
  evaluationFactor Decimal? @db.Decimal(6, 4)
  technicalFactor  Decimal? @db.Decimal(6, 4)
  calculatedPoints Decimal? @db.Decimal(10, 4)
  recognizedPoints Decimal? @db.Decimal(10, 4)

  recognitionDate       DateTime?
  recognitionResolution String?   @db.VarChar(60)
  careerYear            Int
  documentId            String?

