# Ajusta usuario/contraseña/puerto a tu instalación local de PostgreSQL.
# Si la contraseña tiene caracteres especiales (# @ % etc.), deben ir URL-encoded
# (ej. "#" -> "%23"). Puedes verificar el puerto con: pg_lsclusters (Linux/Mac)
# o revisando el servicio "postgresql-x64-<version>" en Windows.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gpr?schema=public"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
